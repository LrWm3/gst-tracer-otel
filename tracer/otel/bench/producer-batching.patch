+    #[test]
+    fn producer_batches_keep_a_record_bound_when_split_across_exports() {
+        let (entered_tx, entered_rx) = bounded(10);
+        let (release_tx, release_rx) = bounded(10);
+        let runtime = Runtime::new(
+            Config {
+                queue_capacity: 7,
+                batch_size: 2,
+                ..Config::default()
+            },
+            GatedExporter {
+                entered: entered_tx,
+                release: release_rx,
+                fail: false,
+            },
+            Resource::builder_empty().build(),
+        )
+        .unwrap();
+        runtime.anchor(100);
+        runtime.ingress.submit((0..4).map(record).collect());
+        entered_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        runtime.ingress.submit((4..9).map(record).collect());
+        runtime.ingress.submit((9..12).map(record).collect());
+        assert_eq!(runtime.ingress.queued.load(Relaxed), 7);
+        assert_eq!(runtime.stats.snapshot().pending_spans, 9);
+        assert_eq!(runtime.stats.snapshot().dropped_queue_full, 3);
+        for _ in 0..5 {
+            release_tx.send(()).unwrap();
+        }
+        let stats = runtime.shutdown(Duration::from_secs(2)).unwrap();
+        assert_eq!(stats.exported_spans, 9);
+        assert_eq!(stats.completed_spans, 12);
+        assert_eq!(stats.pending_spans, 0);
+        assert_eq!(runtime.ingress.queued.load(Relaxed), 0);
+    }
+
+    #[test]
+    fn abandoned_partial_batches_account_for_a_destroyed_runtime() {
+        let runtime = runtime(Config::default(), Collector::default());
+        let stats = runtime.stats.clone();
+        let mut batch = ProducerBatch::new(&runtime);
+        batch.push(record(0), false);
+        drop(runtime);
+        drop(batch);
+        assert_eq!(stats.snapshot().completed_spans, 1);
+        assert_eq!(stats.snapshot().dropped_closed, 1);
+    }
