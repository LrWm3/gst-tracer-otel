+impl Ingress {
+    pub fn batch_capacity(&self) -> usize {
+        PRODUCER_BATCH.min(self.capacity)
+    }
+    pub fn batch(&self) -> Vec<Record> {
+        self.recycled
+            .try_recv()
+            .unwrap_or_else(|_| Vec::with_capacity(self.batch_capacity()))
+    }
+    pub fn submit(&self, mut records: Vec<Record>) {
+        let count = records.len();
+        if count == 0 {
+            return;
+        }
+        let index = shard_index();
+        let stats = &self.stats.shards[index];
+        let active = &self.submissions[index].0;
+        stats.completed_spans.fetch_add(count as u64, Relaxed);
+        // SeqCst orders registration, the closed check, and shutdown's scan.
+        // Any producer that sees open is registered before closure; any producer
+        // registering after the shutdown scan must see closed and cannot enqueue.
+        active.fetch_add(1, SeqCst);
+        if !self.accepting.load(SeqCst) {
+            active.fetch_sub(1, Release);
+            stats.dropped_closed.fetch_add(count as u64, Relaxed);
+            return;
+        }
+        if self
+            .queued
+            .fetch_update(Relaxed, Relaxed, |queued| {
+                (count <= self.capacity.saturating_sub(queued)).then_some(queued + count)
+            })
+            .is_err()
+        {
+            stats.dropped_queue_full.fetch_add(count as u64, Relaxed);
+            records.clear();
+            let _ = self.recycle.try_send(records);
+            active.fetch_sub(1, Release);
+            return;
+        }
+        match self.sender.try_send(Message::Spans(records)) {
+            Ok(()) => {
+                stats.enqueued_spans.fetch_add(count as u64, Relaxed);
+            }
+            Err(error) => {
+                let counter = match error {
+                    TrySendError::Full(_) => &stats.dropped_queue_full,
+                    TrySendError::Disconnected(_) => &stats.dropped_closed,
+                };
+                counter.fetch_add(count as u64, Relaxed);
+                self.queued.fetch_sub(count, Relaxed);
+            }
+        }
+        active.fetch_sub(1, Release);
+    }
+}
+
+// A live streaming thread owns at most one partial batch. Weak ownership lets
+// runtime destruction disconnect the worker even if that thread remains idle.
+pub(crate) struct ProducerBatch {
+    owner: Weak<Ingress>,
+    stats: Arc<Counters>,
+    records: Vec<Record>,
+    limit: usize,
+}
+impl ProducerBatch {
+    pub fn new(runtime: &Runtime) -> Self {
+        Self {
+            owner: Arc::downgrade(&runtime.ingress),
+            stats: runtime.stats.clone(),
+            records: runtime.ingress.batch(),
+            limit: runtime.ingress.batch_capacity(),
+        }
+    }
+    pub fn belongs_to(&self, runtime: &Runtime) -> bool {
+        std::ptr::eq(self.owner.as_ptr(), Arc::as_ptr(&runtime.ingress))
+    }
+    pub fn push(&mut self, record: Record, outer_finished: bool) {
+        if self.records.capacity() == 0 {
+            self.records = self
+                .owner
+                .upgrade()
+                .map_or_else(|| Vec::with_capacity(self.limit), |owner| owner.batch());
+        }
+        self.records.push(record);
+        if outer_finished || self.records.len() == self.limit {
+            self.publish();
+        }
+    }
+    pub fn publish(&mut self) {
+        if self.records.is_empty() {
+            return;
+        }
+        let records = std::mem::take(&mut self.records);
+        if let Some(owner) = self.owner.upgrade() {
+            owner.submit(records);
+        } else {
+            let stats = self.stats.local();
+            stats
+                .completed_spans
+                .fetch_add(records.len() as u64, Relaxed);
+            stats
+                .dropped_closed
+                .fetch_add(records.len() as u64, Relaxed);
+        }
+    }
+}
+impl Drop for ProducerBatch {
+    fn drop(&mut self) {
+        self.publish();
