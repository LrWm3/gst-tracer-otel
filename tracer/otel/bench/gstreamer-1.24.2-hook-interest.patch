diff --git a/gst/gsttracerutils.c b/gst/gsttracerutils.c
--- a/gst/gsttracerutils.c
+++ b/gst/gsttracerutils.c
@@ -64,6 +64,9 @@
 /* tracing helpers */

 gboolean _priv_tracer_enabled = FALSE;
+/* Registration, like the existing hook table, happens before streaming starts. */
+G_STATIC_ASSERT (GST_TRACER_QUARK_MAX <= 64);
+guint64 _priv_tracer_hook_mask = 0;
 GHashTable *_priv_tracers = NULL;

 /* Initialize the tracing system */
@@ -159,6 +162,7 @@
   GList *h_list, *h_node, *t_node;
   GstTracerHook *hook;

+  _priv_tracer_hook_mask = 0;
   _priv_tracer_enabled = FALSE;
   if (!_priv_tracers)
     return;
@@ -191,6 +195,17 @@
   g_hash_table_replace (_priv_tracers, key, list);
   GST_DEBUG ("registering tracer for '%s', list.len=%d",
       (detail ? g_quark_to_string (detail) : "*"), g_list_length (list));
+  if (detail == 0) {
+    /* Wildcard tracers must observe every hook, including otherwise unused ones. */
+    _priv_tracer_hook_mask = G_MAXUINT64;
+  } else {
+    for (guint i = 0; i < GST_TRACER_QUARK_MAX; i++) {
+      if (_priv_gst_tracer_quark_table[i] == detail) {
+        _priv_tracer_hook_mask |= G_GUINT64_CONSTANT (1) << i;
+        break;
+      }
+    }
+  }
   _priv_tracer_enabled = TRUE;
 }

